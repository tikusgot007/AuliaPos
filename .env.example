# Copy this file to `.env` and fill in real values for your environment.
# `.env` is gitignored and MUST NOT be committed.

# ------------------------------------------------------------------
# Application
# ------------------------------------------------------------------
CI_ENVIRONMENT = development

# Absolute URL of the app root, WITH a trailing slash. Required: CodeIgniter
# rejects an empty/invalid baseURL at bootstrap. Must match the URL prefix
# where the app is served (mirroring RewriteBase in .htaccess).
app.baseURL = 'http://localhost/aulia/'

# ------------------------------------------------------------------
# Main database (transactions, products, users, ...)
# ------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = aulia_kasirdb
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.port = 3306

# ------------------------------------------------------------------
# WhatsApp inbox database
# ------------------------------------------------------------------
database.inbox.hostname = localhost
database.inbox.database = aulia_inboxdb
database.inbox.username = root
database.inbox.password =
database.inbox.DBDriver = MySQLi
database.inbox.port = 3306

# ------------------------------------------------------------------
# WhatsApp inbox gateway
# ------------------------------------------------------------------
inbox.gatewayBaseUrl = 'http://127.0.0.1:3000'
inbox.gatewayToken = 'change-me'
inbox.mediaStoragePath = 'D:/aulia_inbox_media/'
# Max prefetch size for incoming media (MB, default 15).
# inbox.maxMediaPrefetchMb = 15

# ------------------------------------------------------------------
# Receipt printing (local Windows helpers)
# ------------------------------------------------------------------
printnota.sumatraPdfPath = "C:\SumatraPDF\SumatraPDF.exe"
printnota.printerLangsung = ""
printnota.printSettings = "protrait,paper=A6"
