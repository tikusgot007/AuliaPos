# === Environment & credential -- JANGAN PERNAH ter-commit ===
.env
.env.*
!.env.example

# === Dependency (di-install ulang lewat composer install) ===
/vendor/

# === Runtime AuliaPos (log, cache, session file, upload) ===
/writable/cache/*
!/writable/cache/index.html
/writable/logs/*
!/writable/logs/index.html
/writable/session/*
!/writable/session/index.html
/writable/uploads/*
/writable/backups/*
/writable/debugbar/*
!/writable/debugbar/index.html
!/writable/uploads/index.html
/writable/archive/*
!/writable/archive/index.html

# === OS/editor ===
.DS_Store
Thumbs.db
.vscode/
.idea/

# === Test/build artifacts ===
/build/

# === AI tool local state (Kilo worktrees, agent manager) ===
.kilo/

# === SDLC planning/verification artifacts -- intentionally local only (CON-006) ===
# Plan and verification scripts live in the working tree only; they are not
# part of the shipped application. Checkpoints that must persist belong in
# docs/sesi/ (tracked).
/plan/
/verify/

# === Agent rules -- MUST stay tracked, never ignore ===
# AGENTS.md is shared project knowledge (see AGENTS.md section 14).
!AGENTS.md

# === Override lingkungan -- .htaccess beda dev vs produksi ===
# RewriteBase dev = /aulia-app/ , produksi = /aulia/ . File nyata sengaja TIDAK
# dilacak supaya `git pull` di server tidak menimpa RewriteBase produksi
# (pernah dijaga manual dengan skip-worktree). Contoh: .htaccess.example.
/.htaccess
/public/.htaccess
