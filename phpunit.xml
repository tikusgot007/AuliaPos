<?xml version="1.0" encoding="UTF-8"?>
<!--
  PHPUnit config for unit tests. Some unit tests extend CIUnitTestCase, so the
  CodeIgniter test bootstrap is required to define the framework test constants.
  This suite still does not connect to the production or development database.
  Compatible with PHPUnit 9.6 and 10.5+ (no coverage/source section on purpose).
  Run: vendor/bin/phpunit
-->
<phpunit bootstrap="vendor/codeigniter4/framework/system/Test/bootstrap.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true"
         beStrictAboutTestsThatDoNotTestAnything="true">
    <testsuites>
        <testsuite name="unit">
            <directory suffix="Test.php">tests/unit</directory>
        </testsuite>
    </testsuites>
    <php>
        <ini name="error_reporting" value="-1"/>
        <env name="TZ" value="Asia/Jakarta"/>
    </php>
</phpunit>
